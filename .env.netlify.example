# Credenciais das integrações existentes
SNOOP_API_TOKENS=token_1,token_2
BLACKCAT_BASE_URL=https://api.blackcatoficial.com/api
BLACKCAT_API_KEY=sua_chave_blackcat

# Senha usada para entrar em /admin.html (obrigatória)
ADMIN_PASSWORD=troque-por-uma-senha-longa-e-unica

# Opcionais: se omitidos, as Functions usam as credenciais acima para assinar tokens.
ADMIN_SESSION_SECRET=troque-por-outro-segredo-aleatorio
PROOF_UPLOAD_SECRET=troque-por-outro-segredo-aleatorio

# Fallback caso o contexto automático do Blobs não seja injetado no deploy.
# NETLIFY_SITE_ID já costuma existir automaticamente; o token deve ser um PAT da Netlify.
NETLIFY_SITE_ID=id-do-projeto-netlify
NETLIFY_BLOBS_TOKEN=token-pessoal-netlify
